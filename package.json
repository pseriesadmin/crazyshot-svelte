{
  "name": "crazyshot-web",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "harness:check": "eslint src --ext .ts,.svelte && tsc --noEmit",
    "harness:fix": "eslint src --ext .ts,.svelte --fix",
    "harness:gc": "npx ts-prune src --error 2>/dev/null || true",
    "boundary:check": "node scripts/boundary-validator.cjs",
    "boundary:report": "node scripts/boundary-validator.cjs --verbose",
    "harness:health": "bash scripts/harness-health-check.sh",
    "harness:health:fix": "bash scripts/harness-health-check.sh --fix",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "patch-package"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/ui": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-svelte": "^3.18.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "supabase": "^2.111.0",
    "svelte": "^5.55.10",
    "svelte-check": "^4.7.6",
    "svelte-i18n": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-color": "^3.29.2",
    "@tiptap/extension-font-family": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "hwp-convert": "^1.13.0",
    "jspreadsheet-ce": "^5.0.4",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "svelte-sonner": "^1.1.1",
    "svelte-tiptap": "^3.0.1",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.0",
    "xlsx": "^0.18.5"
  },
  "lint-staged": {
    "src/**/*.{ts,svelte}": "eslint --max-warnings=0 --no-warn-ignored"
  },
  "prepare": "husky install"
}
